{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://svbion.github.io/gpu-benchmark-lab/schemas/benchmark-package/v0.1/manifest.schema.json",
  "type": "object",
  "required": [
    "schema_version",
    "benchmark_id",
    "files"
  ],
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "benchmark_id": {
      "type": "string"
    },
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "path",
          "sha256",
          "size_bytes"
        ]
      }
    }
  }
}
